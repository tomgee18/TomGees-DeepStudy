{
  "enabled": true,
  "name": "Documentation Sync",
  "description": "Listens to all TypeScript source files, configuration files, and other relevant project files. When changes are detected, triggers documentation updates in README.md or docs folder to keep documentation in sync with code changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "*.ts",
      "*.tsx",
      "package.json",
      "vite.config.ts",
      "tailwind.config.ts",
      "tsconfig*.json",
      "components.json",
      "supabase/**/*.sql",
      "supabase/**/*.ts",
      "AI_RULES.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Source code or configuration files have been modified in this React TypeScript project. Please review the changes and update the documentation accordingly. Focus on:\n\n1. Update README.md if there are significant feature changes, new dependencies, or architectural updates\n2. If there's a /docs folder, update relevant documentation files there\n3. Ensure documentation reflects current functionality, API changes, component updates, or configuration modifications\n4. Update any code examples, installation instructions, or usage guides that may be affected\n5. Keep the documentation clear, accurate, and helpful for developers and users\n\nPlease analyze what changed and determine what documentation updates are needed to maintain accuracy and completeness."
  }
}